#:import theme hub.theme
#:import dp kivy.metrics.dp
#:import GameStage hub.gamekit.GameStage

<PilarPanel>:
    FloatLayout:
        id: arena

        GameStage:
            id: stage

        Label:
            text: str(int(root.score))
            font_size: "54sp"
            bold: True
            color: 1, 1, 1, 1
            outline_width: dp(3)
            outline_color: 0.1, 0.1, 0.15, 1
            size_hint: None, None
            size: dp(180), dp(70)
            pos_hint: {"center_x": 0.5, "top": 0.96}

        Label:
            text: "MEJOR  " + str(int(root.best))
            font_size: "14sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(120), dp(44)
            pos: arena.right - self.width - dp(12), arena.top - dp(54)

        Card:
            id: start_card
            size_hint: None, None
            size: (0, 0) if root.phase == "play" else (min(arena.width - dp(48), dp(340)), self.minimum_height)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0 if root.phase == "play" else 1
            padding: dp(22)
            spacing: dp(10)
            Title:
                text: "¡Cuadrado Saltarín!"
            Body:
                text: "Toca la pantalla para saltar y esquivar los obstáculos."
            Caption:
                text: "Puntuación: " + str(int(root.score)) + "  |  Mejor: " + str(int(root.best))
            PillButton:
                text: "Jugar" if root.phase == "ready" else "Jugar otra vez"
                accent: root.accent
                on_release: root.play_again() if root.phase == "over" else root.start_game()
