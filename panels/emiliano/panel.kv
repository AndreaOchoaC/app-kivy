#:import theme hub.theme
#:import dp kivy.metrics.dp

# El DISEÑO del juego: el marcador, el aviso «TOCA PARA VOLAR» y la tarjeta de fin de partida.
# El cielo, los tubos y el pájaro se dibujan desde panel.py (dentro del GameStage).

<EmilianoPanel>:
    FloatLayout:
        id: arena

        # Lienzo donde panel.py dibuja el juego
        GameStage:
            id: stage

        # Marcador grande
        Label:
            text: str(int(root.score))
            font_size: "68sp"
            bold: True
            color: 1, 1, 1, 1
            outline_width: dp(4)
            outline_color: 0.1, 0.1, 0.15, 1
            size_hint: None, None
            size: dp(300), dp(90)
            pos_hint: {"center_x": 0.5, "top": 0.88}

        # Aviso inicial
        Label:
            text: "TOCA PARA VOLAR"
            font_size: "24sp"
            bold: True
            color: 1, 1, 1, 1
            outline_width: dp(3)
            outline_color: 0.1, 0.1, 0.15, 1
            size_hint: None, None
            size: dp(360), dp(50)
            pos_hint: {"center_x": 0.5, "center_y": 0.30}
            opacity: 1 if root.phase == "ready" else 0

        # Mejor puntuación (a la derecha del botón «<» flotante)
        Label:
            text: "MEJOR  " + str(int(root.best))
            font_size: "14sp"
            bold: True
            color: 1, 1, 1, 1
            outline_width: dp(2)
            outline_color: 0.1, 0.1, 0.15, 1
            size_hint: None, None
            size: dp(120), dp(44)
            halign: "right"
            valign: "middle"
            text_size: self.size
            pos: arena.right - self.width - dp(16), arena.top - dp(54)

        # Fin de partida: panel.py lo quita al empezar y lo pone al perder
        FloatLayout:
            id: overlay
            Card:
                id: over_card
                size_hint: None, None
                size: min(overlay.width - dp(48), dp(320)), self.minimum_height
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                padding: dp(22)
                spacing: dp(10)
                AnchorLayout:
                    size_hint_y: None
                    height: dp(26)
                    Chip:
                        text: "NUEVO RÉCORD" if root.new_record else "FIN DE LA PARTIDA"
                        tint: theme.WARNING if root.new_record else theme.ACCENT_2
                Title:
                    text: "¡Chocaste!"
                    halign: "center"
                Label:
                    text: str(int(root.score))
                    font_size: "56sp"
                    bold: True
                    color: theme.TEXT
                    size_hint_y: None
                    height: dp(70)
                Caption:
                    text: "Mejor: " + str(int(root.best))
                    halign: "center"
                PillButton:
                    text: "Jugar otra vez"
                    accent: root.accent
                    on_release: root.play_again()
                PillButton:
                    text: "Salir"
                    kind: "secondary"
                    on_release: root.go_home()
